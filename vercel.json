{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "packages/ui/dist",
  "functions": {
    "api/[...path].ts": {
      "includeFiles": "node_modules/sql.js/dist/sql-wasm.wasm"
    }
  },
  "rewrites": [
    { "source": "/overview", "destination": "/index.html" },
    { "source": "/change", "destination": "/index.html" },
    { "source": "/impact", "destination": "/index.html" },
    { "source": "/verification", "destination": "/index.html" },
    { "source": "/findings", "destination": "/index.html" },
    { "source": "/dossier", "destination": "/index.html" }
  ]
}