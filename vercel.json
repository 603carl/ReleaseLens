{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "packages/ui/dist",
  "functions": {
    "api/[...path].ts": {
      "includeFiles": "node_modules/sql.js/dist/sql-wasm.wasm"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}